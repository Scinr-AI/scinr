# scinr-ingest — example environment configuration
# Copy this file to .env and fill in the values for your environment.

# ─── LLM (AWS Bedrock) ──────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
MODEL_ID=                          # e.g. us.anthropic.claude-sonnet-4-6
REPAIR_MODEL_ID=                   # e.g. us.anthropic.claude-haiku-3 (can equal MODEL_ID)
PROMPT_CACHING_ENABLED=true        # Bedrock only — ignored for other providers

# ─── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j                   # NOTE: was NEO4J_USERNAME in previous versions — fixed
NEO4J_PASSWORD=
# Alternative: NEO4J_AUTH=neo4j/password

# ─── PDF Conversion (Mistral OCR) ───────────────────────────────────────────
MISTRAL_API_KEY=                   # required to process PDF files

# ─── Storage (optional) ─────────────────────────────────────────────────────
STORAGE_BACKEND=none               # none (default) | mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=scinr
MONGODB_RAW_FILES_COLLECTION=raw_files
MONGODB_PAGES_COLLECTION=converted_pages
MONGODB_GRIDFS_BUCKET=raw_binaries

# ─── Pipeline ───────────────────────────────────────────────────────────────
EXTRACTION_BATCH_SIZE=1            # pages per extraction chunk
LLM_CONCURRENCY=4                  # max concurrent LLM calls (was BEDROCK_CONCURRENCY)
