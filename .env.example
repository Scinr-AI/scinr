# scinr-ingest — example environment configuration
# Copy this file to .env and fill in the values for your environment.

# ─── LLM ────────────────────────────────────────────────────────────────────
# The usual way to set the LLM is in code:
#   configure(llm=ChatBedrockConverse(model="..."), repair_llm=...)
# Shortcut: if llm is omitted and MODEL_ID is set, a Bedrock ChatBedrockConverse is
# built from it (reads AWS_DEFAULT_REGION, default us-east-1, and MAX_TOKENS, default 65536).
# MODEL_ID=
# Provider SDK settings (e.g. AWS_DEFAULT_REGION, OPENAI_API_KEY) still come
# from the environment as usual.
PROMPT_CACHING_ENABLED=true        # Bedrock only — ignored for other providers

# ─── Graph backend ──────────────────────────────────────────────────────────
# GRAPH_BACKEND=neo4j              # neo4j (default) | postgres | sqlite

# ─── Neo4j ──────────────────────────────────────────────────────────────────
# Required only when GRAPH_BACKEND=neo4j (the default); needs: pip install 'scinr[neo4j]'
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j                   # NOTE: was NEO4J_USERNAME in previous versions — fixed
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j               # target database name
# Alternative: NEO4J_AUTH=neo4j/password

# ─── PDF Conversion (Mistral OCR) ───────────────────────────────────────────
MISTRAL_API_KEY=                   # REQUIRED to process any PDF (PDF conversion is Mistral OCR only)

# ─── PostgreSQL / SQLite (instead of Neo4j; optional) ───────────────────────
# Needs: pip install 'scinr[postgres]' or pip install 'scinr[sqlite]'
# SQL_URL is required when GRAPH_BACKEND, STORAGE_BACKEND or FREEZE_BACKEND is
# postgres or sqlite; its scheme must match (postgresql:// or sqlite:///).
# SQL_URL=postgresql://user:password@localhost:5432/scinr   # or sqlite:///newton.db
# SQL_SCHEMA=newton                # Postgres schema holding the tables (ignored by SQLite)
# SQL_POOL_SIZE=10                 # connection pool size (minimum 1)
# SQL_FULLTEXT_CONFIG=simple       # Postgres text-search config; applied when the schema is created
# SQLITE_FILES_DIR=                # SQLite binaries folder (default: next to the .db file)

# ─── Storage (optional) ─────────────────────────────────────────────────────
STORAGE_BACKEND=none               # none (default) | mongodb | postgres | sqlite | custom
# FREEZE_BACKEND=                  # none | mongodb | postgres | sqlite | custom (default: inherits STORAGE_BACKEND)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=scinr
MONGODB_RAW_FILES_COLLECTION=raw_files
MONGODB_PAGES_COLLECTION=converted_pages
MONGODB_GRIDFS_BUCKET=raw_binaries

# ─── Pipeline ───────────────────────────────────────────────────────────────
EXTRACTION_BATCH_SIZE=1            # pages per extraction chunk
LLM_CONCURRENCY=4                  # max concurrent LLM calls (was BEDROCK_CONCURRENCY)
